# =============================================================================
# SENTIENT TRADER — Environment Variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values from your service dashboards (links below each section)
# 3. Deployment: set these in your host's environment UI/secret store
# =============================================================================

# -- ALPACA (Paper Trading) ---------------------------------------------------
# Dashboard: https://app.alpaca.markets → Paper Trading → API Keys
# ⚠ Use PAPER keys — not live trading keys. No real money should ever move.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -- GROQ ---------------------------------------------------------------------
# Dashboard: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# -- VALKEY / REDIS -----------------------------------------------------------
# Valkey is Redis protocol-compatible. These defaults target a local instance.
# Used by backend/api, backend/agent, and backend/ingestion inside Oracle Cloud.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_KEY=market-news
# REDIS_USERNAME=
# REDIS_PASSWORD=

# -- BACKEND API --------------------------------------------------------------
# Comma-separated browser origins allowed by FastAPI CORS.
CORS_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:3000

# -- SUPABASE -----------------------------------------------------------------
# Dashboard: https://supabase.com → your project → Settings → API
# Use SERVICE ROLE key for backend (bypasses RLS — server-only, never expose)
# Use ANON key to validate browser Supabase access tokens.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DB_SCHEMA=sentient_trader

# -- SUPER USERS (AUTH) -------------------------------------------------------
# Comma-separated list of emails allowed to change config/cancel orders.
SUPER_USER_EMAILS=your_email@gmail.com

# Agent thresholds and prompts live in Supabase agent_config, not process env.
