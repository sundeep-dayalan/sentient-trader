# =============================================================================
# SENTIENT TRADER — Environment Variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values from your service dashboards (links below each section)
# 3. Fly.io deployment: flyctl secrets set KEY=value  (never commit .env)
# =============================================================================

# -- ALPACA (Paper Trading) ---------------------------------------------------
# Dashboard: https://app.alpaca.markets → Paper Trading → API Keys
# ⚠ Use PAPER keys — not live trading keys. No real money should ever move.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# -- GROQ ---------------------------------------------------------------------
# Dashboard: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# -- UPSTASH KAFKA ------------------------------------------------------------
# Dashboard: https://console.upstash.com → Kafka → your cluster → Details
# Bootstrap server format: region-xxx.upstash.io:9092
KAFKA_BOOTSTRAP_SERVER=your-cluster.upstash.io:9092
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password
KAFKA_TOPIC=market-news
# REST endpoint used by the simulation feature (format: https://region-xxx.upstash.io)
KAFKA_REST_ENDPOINT=https://your-cluster.upstash.io

# -- UPSTASH REDIS ------------------------------------------------------------
# Dashboard: https://console.upstash.com → Redis → your db → REST API section
UPSTASH_REDIS_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_TOKEN=your_redis_rest_token_here

# -- SUPABASE -----------------------------------------------------------------
# Dashboard: https://supabase.com → your project → Settings → API
# Use SERVICE ROLE key for backend (bypasses RLS — server-only, never expose)
# Use ANON key for frontend (see frontend/.env.local.example)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# -- AGENT THRESHOLDS (optional — these defaults are already set in fly.toml) -
# Increase thresholds to trade less frequently; decrease to trade more often.
BUY_SENTIMENT_THRESHOLD=0.8
SELL_SENTIMENT_THRESHOLD=-0.8
CONFIDENCE_THRESHOLD=0.9
ORDER_QUANTITY=1
