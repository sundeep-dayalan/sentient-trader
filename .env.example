# =============================================================================
# SENTIENT TRADER — ENVIRONMENT VARIABLES TEMPLATE (LOCAL DEVELOPMENT)
# =============================================================================
# 1. Copy this file to create your local environment file:  cp .env.example .env
# 2. Fill in the values from your service dashboards.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. CORE API SERVICES (ALPACA, SUPABASE, LLM PROVIDERS)
# ─────────────────────────────────────────────────────────────────────────────

# -- ALPACA (Paper Trading) --
# ⚠ Use PAPER keys — not live trading keys. No real money should ever move.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
MOCK_ALPACA=true

# -- SUPABASE --
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_SCHEMA=sentient_trader

# -- LLM PROVIDERS --
# The active provider is selected in Supabase agent_config.llm_provider.
# Keep keys in env; do not store API keys in Supabase JSON.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODELS_URL=https://api.groq.com/openai/v1/models
GROQ_MODEL_DISCOVERY_TIMEOUT=5
GROQ_MIN_CONTEXT_WINDOW=8192
GROQ_MIN_COMPLETION_TOKENS=1024
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=https://sentient-trader.coolify.sundeepdayalan.in
OPENROUTER_APP_TITLE=Sentient Trader

# ─────────────────────────────────────────────────────────────────────────────
# 2. VALKEY / REDIS CONNECTION SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_STREAM_KEY=market-news
REDIS_STREAM_MAX_LEN=1000
# TLS: leave off for a private-subnet Valkey. Set REDIS_SSL=true for a managed
# endpoint (e.g. Upstash / rediss://). REDIS_SSL_CERT_REQS=none disables cert
# verification for self-signed/internal certs (default: required).
REDIS_SSL=false
REDIS_SSL_CERT_REQS=required

# Upstash Redis (Used in simulation / API fallback)
UPSTASH_REDIS_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token_here

# ─────────────────────────────────────────────────────────────────────────────
# 3. INGESTION WORKER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
INGESTION_PROVIDER=alpaca
INGESTION_WORKER_NAME=ingestion
INGESTION_LIVE_ENABLED=true

# Custom base URLs
ALPACA_NEWS_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets

# Redis Key Namespaces
TICKER_META_HASH_KEY=sentient:ticker:meta
TICKER_DIRECTORY_STATE_KEY=sentient:ticker:directory:state
TICKER_ALIAS_OVERRIDES_KEY=sentient:ticker:alias-overrides
TICKER_ALIAS_OVERRIDES_JSON=
TICKER_ALIAS_OVERRIDES_PATH=

# Ticker Refresh Intervals (in seconds)
TICKER_DIRECTORY_REFRESH_SECONDS=86400
TICKER_DIRECTORY_REFRESH_CHECK_SECONDS=60
TICKER_DIRECTORY_HTTP_TIMEOUT_SECONDS=15.0

# News Filtering Scores (matching thresholds)
TICKER_HEADLINE_MATCH_SCORE=100
TICKER_SUMMARY_MATCH_SCORE=35
TICKER_BODY_MATCH_SCORE=15
TICKER_PUBLISH_SCORE_THRESHOLD=80

# Ingestion Backfill Settings (in seconds/pages)
INGESTION_STARTUP_BACKFILL_SECONDS=900
INGESTION_RECONNECT_BACKFILL_SECONDS=300
INGESTION_BACKFILL_HTTP_TIMEOUT_SECONDS=10.0
INGESTION_BACKFILL_PAGE_LIMIT=50
INGESTION_BACKFILL_MAX_PAGES=20

# Reliability and Deduplication
INGESTION_DEDUPE_HEADLINE_WINDOW_SECONDS=21600
INGESTION_OUTBOX_BATCH_SIZE=25
INGESTION_OUTBOX_RETRY_INTERVAL_SECONDS=10.0
INGESTION_OUTBOX_MAX_RETRY_DELAY_SECONDS=300
INGESTION_STREAM_RECONNECT_MAX_DELAY_SECONDS=60
INGESTION_HEARTBEAT_INTERVAL_SECONDS=30.0

# ─────────────────────────────────────────────────────────────────────────────
# 4. AGENT WORKER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
AGENT_WORKER_NAME=agent
AGENT_CONFIG_REFRESH_SECONDS=5
REDIS_CONSUMER_GROUP=sentient-agent-group
REDIS_CONSUMER_NAME=local-dev-1
REDIS_CONSUMER_START_ID=0
REDIS_QUOTA_RETRY=60

# Signal Age Windows (in seconds)
AGENT_MAX_TRADE_SIGNAL_AGE_SECONDS=900
AGENT_MAX_AUDIT_SIGNAL_AGE_SECONDS=86400

# Retries and Queue Management
AGENT_MAX_PROCESSING_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY_SECONDS=30
AGENT_RETRY_MAX_DELAY_SECONDS=300
AGENT_RETRY_BATCH_SIZE=5
AGENT_PENDING_IDLE_SECONDS=60
AGENT_PENDING_BATCH_SIZE=5

# Outcome labeler scheduler
OUTCOME_LABELER_ENABLED=false
OUTCOME_LABELER_INTERVAL_SECONDS=3600
OUTCOME_LABELER_LIMIT=250
OUTCOME_LABELER_RUN_ON_STARTUP=true
SCHEDULER_RUN_TRACKING_ENABLED=true

# Agent Redis Stream Overrides
AGENT_RETRY_ZSET_KEY=market-news:agent-retry
AGENT_RETRY_HASH_KEY=market-news:agent-retry-payloads
AGENT_DLQ_STREAM_KEY=market-news:agent-dlq

# LLM daily-call budget kill-switch. 0 = unlimited (disabled). When a positive
# cap is reached, the agent drops to pre-screen-only mode (deterministic HOLD, no
# more LLM calls) until the UTC-day counter resets — protects against a runaway
# loop quietly burning a paid OpenRouter balance. One debate = 4 calls.
LLM_DAILY_CALL_BUDGET=0
LLM_DEBATE_CALL_COST=4

# ─────────────────────────────────────────────────────────────────────────────
# 5. WORKER HEALTH & OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
WORKER_HEALTH_KEY=sentient:workers:health
# A worker is reported "up" on /metrics while its heartbeat is fresher than this.
WORKER_STALE_AFTER_SECONDS=180
# Prometheus /metrics endpoint. If set, scrapers must send this as a bearer token
# (Authorization: Bearer <token>). Leave blank only on a trusted private network.
METRICS_AUTH_TOKEN=

# -- LANGSMITH (Tracing & Observability) --
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Sentient-Trader

# ─────────────────────────────────────────────────────────────────────────────
# 6. FASTAPI BACKEND API SERVER
# ─────────────────────────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:3000
SUPER_USER_EMAILS=your_email@gmail.com

# -- GLOBAL API RATE LIMITING (SlowAPI) --
API_RATE_LIMIT_ENABLED=true
API_DEFAULT_RATE_LIMITS=120/minute
API_GLOBAL_RATE_LIMITS=300/minute,5000/hour
API_RATE_LIMIT_FALLBACK_LIMITS=120/minute
API_RATE_LIMIT_STRATEGY=fixed-window
# Optional. Leave blank to use Redis from REDIS_* when REDIS_HOST is set, or memory:// locally.
API_RATE_LIMIT_STORAGE_URI=
# REQUIRED when rate limiting is enabled. Secret used to HMAC bearer tokens / IPs
# in rate-limit keys. The API fails fast at startup if this (or SUPABASE_JWT_SECRET)
# is unset — it will NOT fall back to a predictable constant.
API_RATE_LIMIT_KEY_SALT=change_me_to_a_long_random_secret
# Trusted reverse proxies in front of the API (Coolify proxy, etc). The client IP
# is taken as the Nth-from-rightmost X-Forwarded-For hop so the value can't be
# spoofed to evade the anonymous-IP limit. Set to 0 to ignore XFF entirely.
API_TRUSTED_PROXY_COUNT=1

# ─────────────────────────────────────────────────────────────────────────────
# 7. VITE FRONTEND EXPOSED VARIABLES (Safe to expose to browser client)
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_DB_SCHEMA=sentient_trader
VITE_BACKEND_API_URL=http://localhost:8000
VITE_BASE_PATH=
VITE_SUPER_USER_EMAILS=your_email@gmail.com
NEXT_PUBLIC_BASE_PATH=
