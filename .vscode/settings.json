{
  // Point VS Code's Python extension to the root venv so it can resolve
  // all package imports across both backend services without red underlines.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.venvPath": "${workspaceFolder}",
  "python.analysis.venv": ".venv",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend/ingestion",
    "${workspaceFolder}/backend/agent"
  ],
  // Use the root venv for the integrated terminal too
  "python.terminal.activateEnvironment": true,

  // Auto format on save settings
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "black-formatter.path": [
    "${workspaceFolder}/.venv/bin/black"
  ]
}
