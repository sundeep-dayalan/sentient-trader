# frontend/.env.local.example
# Copy to: frontend/.env.local for local development.
# Production values are set in Vercel → Project Settings → Environment Variables.

# -- SUPABASE -----------------------------------------------------------------
# NEXT_PUBLIC_ prefix = safe to expose to the browser (anon key, read-only by default)
# Used for: Realtime live feed, signal reads, Settings page config writes
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -- ALPACA -------------------------------------------------------------------
# Server-only (no NEXT_PUBLIC_ prefix) — used only in /api/portfolio route.
# Never exposed to the browser.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# -- UPSTASH REDIS ------------------------------------------------------------
# Server-only — used by /api/simulate to XADD headlines directly to the stream.
# Same Redis instance used by the ingestion and agent Fly.io services.
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_redis_token_here

# -- REDIS STREAM KEY ---------------------------------------------------------
# Optional. Defaults to "market-news" if not set.
# Must match REDIS_STREAM_KEY on the ingestion and agent services.
# REDIS_STREAM_KEY=market-news
