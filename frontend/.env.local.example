# frontend/.env.local.example
# Copy to: frontend/.env.local
# These are used by Next.js during development and by Vercel in production.

# -- SUPABASE -----------------------------------------------------------------
# NEXT_PUBLIC_ prefix = safe to expose to the browser (read-only anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -- ALPACA -------------------------------------------------------------------
# NO NEXT_PUBLIC_ prefix = server-only (used only in /api/portfolio route)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# -- UPSTASH KAFKA (for /api/simulate route) ----------------------------------
# Server-only — these authenticate writes to Kafka from the simulation button
KAFKA_REST_ENDPOINT=https://your-cluster.upstash.io
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password
KAFKA_TOPIC=market-news
