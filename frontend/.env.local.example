# frontend/.env.local.example
# Copy to: frontend/.env.local for local development.
# Production values are set in Vercel → Project Settings → Environment Variables.

# -- SUPABASE -----------------------------------------------------------------
# NEXT_PUBLIC_ prefix = safe to expose to the browser (anon key, read-only by default)
# Used for: Realtime live feed, signal reads, Settings page config writes
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=sentient_trader

# -- ALPACA -------------------------------------------------------------------
# Server-only (no NEXT_PUBLIC_ prefix) — used only in /api/portfolio route.
# Never exposed to the browser.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# -- VALKEY / REDIS -----------------------------------------------------------
# Server-only. Used by /api/status, /api/simulate, and simulation rate limits.
# Must point to the same Valkey/Redis instance used by ingestion and agent.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_STREAM_KEY=market-news

# -- SUPER USERS (AUTH) -------------------------------------------------------
# Comma-separated list of emails that can edit agent config.
# These users get unlimited simulate access and admin privileges.
SUPER_USER_EMAILS=your_email@gmail.com
NEXT_PUBLIC_SUPER_USER_EMAILS=your_email@gmail.com
