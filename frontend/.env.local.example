# frontend/.env.local.example
# Copy to: frontend/.env.local for local development.
# Production values are set in Netlify → Site configuration → Environment variables.

# -- SUPABASE -----------------------------------------------------------------
# VITE_ prefix = exposed to the browser. Only use public-safe values here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_DB_SCHEMA=sentient_trader

# Set this when the frontend is hosted under a subpath.
# Example: https://apps.sundeepdayalan.in/sentient-trader
VITE_BASE_PATH=/sentient-trader/

# -- ORACLE BACKEND API -------------------------------------------------------
# Public HTTPS URL for the FastAPI service. FastAPI owns all server operations.
VITE_BACKEND_API_URL=https://api.your-domain.com

# -- POSTHOG ANALYTICS --------------------------------------------------------
# Public, write-only project key (safe to expose in the browser bundle).
# Get it from PostHog → Settings → Project → API Keys.
# Leave VITE_PUBLIC_POSTHOG_KEY empty to disable analytics (all calls no-op).
VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
